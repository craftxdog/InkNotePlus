# ./setup.sh crea el archivo .env real con contraseñas aleatorias.
COUCHDB_VERSION=3.5
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=
COUCHDB_SECRET=
INKNOTE_SYNC_USER=inknote
INKNOTE_SYNC_PASSWORD=
INKNOTE_SYNC_DATABASE=inknote
# Dominio público, sin https://
INKNOTE_SYNC_DOMAIN=sync.example.com
COUCHDB_BIND=127.0.0.1
COUCHDB_PORT=5984
COUCHDB_MEMORY=1g
# En servidores con Dokploy, quita el # de la línea siguiente.
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
