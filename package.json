{
  "name": "inknote",
  "productName": "InkNote",
  "version": "1.2.2",
  "private": true,
  "description": "Local-first Markdown notes for desktop.",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "craftzdog",
    "email": "aaronmars77@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac:arm64": "node scripts/make-macos-dmg.mjs arm64",
    "make:mac:x64": "node scripts/make-macos-dmg.mjs x64",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "make:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "release": "node scripts/release.mjs tag",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:renderer": "vitest run tests/renderer",
    "test:desktop": "node scripts/smoke-electron.mjs",
    "test:desktop:audit": "node scripts/smoke-system-audit.mjs",
    "test:desktop:package": "node scripts/smoke-electron.mjs --packaged",
    "build:math-styles": "node scripts/build-math-styles.mjs && oxfmt --write src/renderer/vendor/inkdrop-math/styles/katex.css",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "build": "electron-forge package",
    "check": "pnpm run verify && pnpm run build"
  },
  "devEngines": {
    "packageManager": "pnpm@11.25.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/katex": "0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.1.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "puppeteer-core": "25.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@inkdropapp/css": "0.10.4",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "gemoji": "8.1.0",
    "katex": "0.19.0",
    "lucide-react": "^1.66.0",
    "pele": "1.9.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
